{
  "name": "planogram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/index-exercises.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:py": "cd python && python3 -m pytest -q",
    "data:sample": "cd python && python3 -m boltbeam --sample ../public/data/boltbeam-sample.json",
    "data:full": "cd python && python3 -m boltbeam --out ../data/boltbeam",
    "test:arena": "cd python && .venv/bin/python -m pytest -q tests/test_arena.py",
    "data:arena": "cd python && .venv/bin/python -m arena --out ../public/data/arena.json"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@types/mdx": "^2.0.14",
    "katex": "^0.19.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
